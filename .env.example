# 이 파일은 예시입니다. 실제 값은 Vercel 프로젝트 설정(Environment Variables)에 넣으세요.
# 내 컴퓨터에서 `vercel dev` 로 테스트할 때는 `vercel env pull` 을 실행하면
# .env.local 파일이 자동으로 만들어집니다. (.env.local 은 절대 공유하지 마세요)

# 노션 Integration 토큰 — 필수
NOTION_TOKEN=

# 노션 DB 주소 — 비워두면 코드의 기본값을 사용합니다 (다른 DB를 쓸 때만 입력)
# NOTION_HABITS_DB=19760626b3fd4df8bc4cf8c651701e0f
# NOTION_LOGS_DB=45ad9d239ec64ad1a5a24d305aa2ad41
